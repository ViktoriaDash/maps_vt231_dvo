
@startuml

skinparam defaultFontName sans-serif
skinparam ActivityBackgroundColor #F4F6F8
skinparam ActivityBorderColor #2B4C7E
skinparam ArrowColor #2B4C7E
skinparam PartitionBackgroundColor #FFFFFF
skinparam conditionStyle diamond

|Клієнт|
start
:Оформити заявку на друк;
:Завантажити макет;

|Система|
:Створити об'єкт замовлення;

:Замовлення [нове]; <<object>>

repeat
  :Здійснити автоматичну перевірку формату;
repeat while (Формат некоректний?) is (так) not (ні)

:Надіслати пропозицію менеджеру; <<sendSignal>>

|Менеджер|
:Отримати пропозицію замовлення; <<acceptEvent>>
:Перевірити деталі;

if (Замовлення коректне?) then (так)

  :Прийняти в роботу;

  |Система|
  :Позначити замовлення «в роботі»;

  :Замовлення [в роботі]; <<object>>

  fork
    |Система|
    :Надіслати сигнал клієнту про старт; <<sendSignal>>

    |Клієнт|
    :Отримати сповіщення; <<acceptEvent>>
    :Внести оплату;

  fork again
    |Менеджер|
    :Передати файли на виробництво; <<sendSignal>>

    |Друкар|
    :Отримати макет; <<acceptEvent>>
    :Надрукувати тираж;

  end fork

  |Друкар|
  :Запакувати замовлення;
  :Сповістити про готовність; <<sendSignal>>

  |Система|
  :Оновити статус на «Готово»;

else (ні)

  |Менеджер|
  :Відхилити замовлення;

  |Система|
  :Скасувати замовлення;
  stop

endif

|Система|
:Завершити процес;
stop

legend right
  Умовні позначення:
  Заокруглений прямокутник — дія
  П'ятикутник із виступом праворуч — надсилання сигналу
  Фігура з виїмкою ліворуч — очікування події
  Зелений прямокутник — об'єктний вузол зі станом
  Ромб — рішення / злиття
  Товста лінія — розгалуження й з'єднання
  Кружок у колі — завершення діяльності
endlegend

@enduml
